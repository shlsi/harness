# ---- harness 本地密钥与环境变量覆盖（示例文件）----
# 用法：复制为 .env 后填入真值 ——  copy .env.example .env
# .env 已被 .gitignore 排除，不会提交仓库。

# 【必填】模型密钥。harness.yaml 中以 ${OPENAI_API_KEY} 引用本文件的值。
OPENAI_API_KEY=your-api-key-here

# ---- 以下都是可选：不填就用 harness.yaml 里的值 ----
# 环境变量优先级高于 harness.yaml；只覆盖「存在」的变量（空串也算存在）。
# OPENAI_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL=gpt-6-astra
# HARNESS_MAX_STEPS=12
# HARNESS_SKILLS_DIR=skills
# HARNESS_DATA_DIR=data/sessions
# HARNESS_INTERACTION_TIMEOUT_S=300
# HARNESS_HEARTBEAT_S=15
# HARNESS_RUN_TTL_S=600
